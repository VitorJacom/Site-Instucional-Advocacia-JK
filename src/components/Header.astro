---
import { Image } from "astro:assets";
import simbolojk from "../assets/simbolojk.png";
import { SITE_INFO } from "../lib/constants";

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<header id="main-header" class="header-container">
  <div class="logo-group">
    <a href={base}>
      <Image src={simbolojk} alt="Logo JK Advogados" class="logo-img" />
    </a>
    <div class="logo-text">
      <p class="title">Júlio Sant'Anna & Kassiane Ramos</p>
      <p class="subtitle">Sociedade de Advogados | OAB/RS 10.260</p>
    </div>
  </div>

  <nav class="nav-menu">
    <a
      href={base}
      class={pathname === base || pathname === `${base}/` ? "active" : ""}
      >Início</a
    >
    <a
      href={`${base}/sobre`}
      class={pathname.includes("/sobre") ? "active" : ""}>Sobre Nós</a
    >
    <a
      href={`${base}/atuacao`}
      class={pathname.includes("/atuacao") ? "active" : ""}>Áreas de Atuação</a
    >
    <a
      href={`${base}/artigos`}
      class={pathname.includes("/artigos") ? "active" : ""}>Artigos</a
    >
    <a
      href={`${base}/atendimentos`}
      class={pathname.includes("/atendimentos") ? "active" : ""}>Atendimento</a
    >
    <a
      href={`${base}/contato`}
      class={pathname.includes("/contato") ? "active" : ""}>Contato</a
    >
  </nav>

  <div class="actions-group">
    <a
      href={SITE_INFO.whatsapp.link}
      class="btn-whatsapp"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 448 512" fill="currentColor">
        <path
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.7-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        ></path>
      </svg>
      <span>Falar Conosco</span>
    </a>
    <button class="btn-search">
      <svg
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  /* Seus estilos permanecem os mesmos... */
  .header-container {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent);
    transition: all 0.3s ease-in-out;
  }
  .header-container.scrolled {
    background-color: #0f172a;
    padding: 0.75rem 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .logo-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .logo-img {
    height: 3rem;
    width: auto;
  }
  .logo-text {
    display: none;
    color: white;
    font-family: "Playfair Display", serif;
    font-style: italic;
  }
  .logo-text .title {
    font-weight: bold;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: 0.025em;
  }
  .logo-text .subtitle {
    font-size: 0.875rem;
    color: #d1d5db;
  }
  .nav-menu {
    display: none;
    align-items: center;
    gap: 2rem;
    font-family: sans-serif;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .nav-menu a {
    color: #d1d5db;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-menu a:hover {
    color: white;
  }
  .nav-menu a.active {
    color: #519cae;
  }
  .actions-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .btn-whatsapp {
    display: none;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #9ca3af;
    border-radius: 0.25rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: white;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .btn-whatsapp:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
  .btn-whatsapp svg {
    height: 1.25rem;
    width: 1.25rem;
    color: #22c55e;
  }
  .btn-search {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    transition: color 0.2s;
  }
  .btn-search:hover {
    color: #d1d5db;
  }
  .btn-search svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  @media (min-width: 640px) {
    .logo-text {
      display: block;
    }
  }
  @media (min-width: 768px) {
    .btn-whatsapp {
      display: flex;
    }
    .logo-img {
      height: 3.5rem;
    }
  }
  @media (min-width: 1280px) {
    .nav-menu {
      display: flex;
    }
  }
</style>

<script>
  const header = document.getElementById("main-header");
  if (header) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    });
  }
</script>
