---
import { SITE_INFO } from "../../lib/constants";
---

<section class="form-section">
  <div class="container">
    <div class="form-wrapper">
      <div class="form-header">
        <h2 class="title">Envie sua Mensagem</h2>
        <p>
          Preencha os campos abaixo para iniciarmos seu atendimento jurídico.
        </p>
      </div>

      <form id="contact-form" class="contact-form">
        <input
          type="hidden"
          name="_subject"
          value="Novo contato pelo site - JK Advogados"
        />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />

        <div class="input-group">
          <input
            type="text"
            name="Nome"
            placeholder="Seu Nome Completo"
            required
          />
          <input
            type="email"
            name="Email"
            placeholder="E-mail de Contato"
            required
          />
        </div>

        <div class="input-group">
          <input
            type="tel"
            name="Telefone"
            placeholder="Telefone / WhatsApp"
            required
          />
          <select name="Assunto" required>
            <option value="" disabled selected>Assunto de Interesse</option>
            <option value="Direito do Trabalho">Direito do Trabalho</option>
            <option value="Direito Previdenciário"
              >Direito Previdenciário</option
            >
            <option value="Direito Civil">Direito Civil</option>
            <option value="Outros">Outros / Dúvida Geral</option>
          </select>
        </div>

        <textarea
          name="Mensagem"
          rows="5"
          placeholder="Descreva brevemente sua situação..."
          required></textarea>

        <button type="submit" id="submit-btn" class="btn-send"
          >ENVIAR MENSAGEM</button
        >

        <div id="success-message" class="alert-success">
          Sua mensagem foi enviada com sucesso! Em breve entraremos em contato.
        </div>
      </form>

      <div class="whatsapp-box">
        <p>Prefere um contato imediato?</p>
        <a
          href={SITE_INFO.whatsapp.link}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
            ></path></svg
          >
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const contactForm = document.getElementById("contact-form");
  const submitBtn = document.getElementById("submit-btn");
  const successMessage = document.getElementById("success-message");

  contactForm.addEventListener("submit", async (e) => {
    e.preventDefault(); // Impede o redirecionamento

    submitBtn.disabled = true;
    submitBtn.innerText = "Enviando...";

    const formData = new FormData(contactForm);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch(
        "https://formsubmit.co/ajax/vjds.vitor@gmail.com",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: json,
        },
      );

      if (response.ok) {
        successMessage.style.display = "block";
        contactForm.reset();
        submitBtn.style.display = "none";
      } else {
        alert("Ocorreu um erro ao enviar. Tente novamente mais tarde.");
        submitBtn.disabled = false;
        submitBtn.innerText = "ENVIAR MENSAGEM";
      }
    } catch (error) {
      alert("Erro de conexão. Verifique sua internet.");
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .form-section {
    padding: 4rem 2rem 8rem;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
  }
  .container {
    width: 100%;
    max-width: 800px;
  }
  .form-wrapper {
    background: #f8fafc;
    padding: 3.5rem;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .form-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .form-header .title {
    font-family: "Playfair Display", serif;
    font-size: 2.2rem;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }
  .form-header p {
    color: #64748b;
    font-family: sans-serif;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group {
    display: flex;
    gap: 1.5rem;
  }
  .input-group > * {
    flex: 1;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: white;
    font-family: sans-serif;
    font-size: 1rem;
    color: #1e293b;
    box-sizing: border-box;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #519cae;
    outline: none;
    box-shadow: 0 0 0 3px rgba(81, 156, 174, 0.1);
  }
  textarea {
    resize: vertical;
  }

  .btn-send {
    width: 100%;
    padding: 1.2rem;
    background: #1e293b;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-family: sans-serif;
    cursor: pointer;
    transition: background 0.3s;
    margin-top: 0.5rem;
  }
  .btn-send:hover {
    background: #519cae;
  }
  .btn-send:disabled {
    background: #94a3b8;
    cursor: not-allowed;
  }

  /* Estilo da mensagem de sucesso */
  .alert-success {
    display: none;
    padding: 1rem;
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
    text-align: center;
    font-family: sans-serif;
    font-weight: 600;
  }

  .whatsapp-box {
    margin-top: 3.5rem;
    text-align: center;
    border-top: 1px solid #e2e8f0;
    padding-top: 3rem;
  }
  .whatsapp-box p {
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 1.5rem;
    font-family: sans-serif;
  }
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: #25d366;
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    font-family: sans-serif;
    transition: transform 0.2s;
  }
  .btn-whatsapp:hover {
    transform: scale(1.05);
  }
  .btn-whatsapp svg {
    width: 22px;
  }

  @media (max-width: 640px) {
    .input-group {
      flex-direction: column;
      gap: 1.5rem;
    }
    .form-wrapper {
      padding: 2rem 1.5rem;
    }
    .form-header .title {
      font-size: 1.8rem;
    }
  }
</style>
