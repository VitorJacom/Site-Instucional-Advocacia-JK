---
import { getEntry } from "astro:content";

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith("/") ? base.slice(0, -1) : base;

const contatoEntry = await getEntry("contatos", "contato");
const { escritorios = [], demais_locais = [] } = contatoEntry?.data || {};

const escritoriosProcessados = escritorios.map((escritorio) => {
  let imgPath = escritorio.imagem;
  if (!imgPath) {
    imgPath = `${cleanBase}/src/assets/simbolojk.png`;
  } else if (!imgPath.startsWith(cleanBase)) {
    imgPath = `${cleanBase}${imgPath.startsWith("/") ? "" : "/"}${imgPath}`;
  }
  return {
    ...escritorio,
    imagem: imgPath,
  };
});
---

<section class="locais-section">
  <div class="container">
    <h2 class="section-heading">Nossos Escritórios</h2>

    <div class="offices-grid">
      {
        escritoriosProcessados.map((escritorio) => (
          <div class="office-card">
            <div class="office-image">
              <img
                src={escritorio.imagem}
                alt={escritorio.nome}
                class="office-img"
                onerror={`this.onerror=null; this.src='${cleanBase}/src/assets/simbolojk.png';`}
              />
            </div>
            <div class="office-info">
              <h3>{escritorio.nome}</h3>
              <p set:html={escritorio.endereco.replace(/\n/g, "<br />")} />
              {escritorio.horario && (
                <p class="hours">
                  <strong>Horário:</strong> {escritorio.horario}
                </p>
              )}
              {escritorio.link_maps && (
                <a
                  href={escritorio.link_maps}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-maps"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  VER NO MAPS
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    {
      demais_locais && demais_locais.length > 0 && (
        <div class="outros-locais">
          <h3>Atendimento em Demais Locais</h3>
          <div class="locais-tags">
            {demais_locais.map((local) => (
              <span>{local}</span>
            ))}
          </div>
        </div>
      )
    }

    <div class="modalidades-box">
      <h3>Modalidades de Atendimento</h3>
      <div class="modalidades-grid">
        <div class="modalidade">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
          <h4>Presencial</h4>
          <p>
            Atendemos em nossas sedes físicas em Santo Antônio da Patrulha, Capão
            da Canoa ou sindicatos parceiros.
          </p>
        </div>
        <div class="modalidade">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
              x1="8"
              y1="21"
              x2="16"
              y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
          >
          <h4>Online</h4>
          <p>
            Consultas virtuais via Google Meet, Zoom ou WhatsApp, garantindo
            suporte jurídico em qualquer lugar do Brasil.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .locais-section {
    padding: 6rem 2rem;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-heading {
    font-family: "Playfair Display", serif;
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 4rem;
    color: #1e293b;
  }

  .offices-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 5rem;
  }

  .office-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s;
  }
  .office-card:hover {
    transform: translateY(-5px);
  }

  .office-image {
    height: 250px;
    background-color: #e2e8f0;
  }
  .office-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .office-info {
    padding: 2.5rem;
  }
  .office-info h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    color: #0f172a;
    margin-bottom: 1rem;
  }
  .office-info p {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .office-info .hours {
    font-size: 0.9rem;
    color: #64748b;
  }

  .btn-maps {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #1e293b;
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.85rem;
    transition: background 0.3s;
    margin-top: 1.5rem;
  }
  .btn-maps:hover {
    background-color: #519cae;
  }
  .btn-maps svg {
    width: 18px;
  }

  .outros-locais {
    text-align: center;
    padding: 3rem;
    background: white;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    margin-bottom: 5rem;
  }
  .outros-locais h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    margin-bottom: 2rem;
    color: #1e293b;
  }
  .locais-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .locais-tags span {
    background: #f1f5f9;
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
    font-size: 0.9rem;
    color: #475569;
    font-weight: 600;
  }

  .modalidades-box {
    background: #1e293b;
    color: white;
    padding: 4rem;
    border-radius: 12px;
    text-align: center;
    margin-top: 4rem;
  }
  .modalidades-box h3 {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    margin-bottom: 3rem;
  }
  .modalidades-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .modalidade {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .modalidade svg {
    width: 48px;
    height: 48px;
    color: #519cae;
    margin-bottom: 1rem;
  }
  .modalidade h4 {
    font-family: sans-serif;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .modalidade p {
    font-family: sans-serif;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 400px;
  }

  @media (max-width: 900px) {
    .offices-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .modalidades-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .modalidades-box {
      padding: 3rem 2rem;
    }
  }
</style>
