---
import { Image } from "astro:assets";
import imgSedeSap from "../../assets/sap.png";
import imgSedeCapao from "../../assets/capaoDaCanoa.png";
---

<section class="locais-section">
  <div class="container">
    <h2 class="section-heading">Nossos Escritórios</h2>

    <div class="offices-grid">
      <div class="office-card">
        <div class="office-image">
          <Image
            src={imgSedeSap}
            alt="Sede Santo Antônio da Patrulha"
            class="office-img"
          />
        </div>
        <div class="office-info">
          <h3>Santo Antônio da Patrulha (Sede)</h3>
          <p>
            Rua Marechal Floriano Peixoto, 284, sala 202<br />Bairro Cidade Alta
            | CEP 95.500-000
          </p>
          <p class="hours">
            <strong>Horário:</strong> Seg. a Sex., 08:30 às 11:30 e 13:30 às 18:00
          </p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=JK+Advogados&query_place_id=ChIJ5fJxvhz4GJURZNLF54i_p-Q"
            target="_blank"
            class="btn-maps"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
              ></path><circle cx="12" cy="10" r="3"></circle></svg
            >
            VER NO MAPS
          </a>
        </div>
      </div>

      <div class="office-card">
        <div class="office-image">
          <Image
            src={imgSedeCapao}
            alt="Filial Capão da Canoa"
            class="office-img"
          />
        </div>
        <div class="office-info">
          <h3>Capão da Canoa</h3>
          <p>
            Rua José Frederico Hoffmann, 43, sala 05<br />Bairro Santa Luzia |
            CEP 95.555-000
          </p>
          <p class="hours">
            <strong>Horário:</strong> Seg. a Sex., 08:30 às 11:30 e 13:30 às 18:00
          </p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=JK+Advogados&query_place_id=ChIJx3c_RIN4GJURS1iuPl5fQUI"
            target="_blank"
            class="btn-maps"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
              ></path><circle cx="12" cy="10" r="3"></circle></svg
            >
            VER NO MAPS
          </a>
        </div>
      </div>
    </div>

    <div class="outros-locais">
      <h3>Atendimento em Demais Locais</h3>
      <div class="locais-tags">
        <span>Sindicato Metalúrgicos Taquara</span>
        <span>Sindicato Alimentação SAP</span>
        <span>Sindisaúde RS</span>
        <span>Vale dos Sinos (São Leopoldo)</span>
      </div>
    </div>
  </div>
</section>

<style>
  .locais-section {
    padding: 6rem 2rem;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-heading {
    font-family: "Playfair Display", serif;
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 4rem;
    color: #1e293b;
  }

  .offices-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 5rem;
  }

  .office-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s;
  }
  .office-card:hover {
    transform: translateY(-5px);
  }

  .office-image {
    height: 250px;
    background-color: #e2e8f0;
  }
  .office-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .office-info {
    padding: 2.5rem;
  }
  .office-info h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    color: #0f172a;
    margin-bottom: 1rem;
  }
  .office-info p {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .office-info .hours {
    font-size: 0.9rem;
    color: #64748b;
  }

  .btn-maps {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #1e293b;
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.85rem;
    transition: background 0.3s;
    margin-top: 1.5rem;
  }
  .btn-maps:hover {
    background-color: #519cae;
  }
  .btn-maps svg {
    width: 18px;
  }

  .outros-locais {
    text-align: center;
    padding: 3rem;
    background: white;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }
  .outros-locais h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    margin-bottom: 2rem;
    color: #1e293b;
  }
  .locais-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .locais-tags span {
    background: #f1f5f9;
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
    font-size: 0.9rem;
    color: #475569;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .offices-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
