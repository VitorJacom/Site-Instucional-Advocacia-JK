---
import { Image } from "astro:assets";
import simbolojk from "../assets/simbolojk.png";
import selo from "../assets/selo.png";
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <section class="quote-section">
    <div class="quote-icon">“</div>
    <h2 class="quote-text">
      A lei é para todos, mas o direito não socorre a quem dorme.
    </h2>
    <Image src={simbolojk} alt="Logo JK Advogados" class="quote-logo" />
  </section>

  <section class="main-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <Image src={simbolojk} alt="JK Advogados" class="footer-logo" />
          <p class="brand-text">
            Júlio César & Kassiane Ramos Sociedade de Advogados
          </p>
          <p class="brand-cnpj">CNPJ: 40.919.164/0001-31</p>
        </div>

        <div class="footer-nav">
          <h4 class="footer-heading">Navegação</h4>
          <a href={base}>Início</a>
          <a href={`${base}/sobre`}>Sobre Nós</a>
          <a href={`${base}/atuacao`}>Áreas de Atuação</a>
          <a href={`${base}/artigos`}>Artigos</a>
          <a href={`${base}/atendimentos`}>Atendimentos</a>
          <a href={`${base}/contato`}>Contato</a>
        </div>

        <div class="footer-contact">
          <h4 class="footer-heading">Contato</h4>
          <div class="contact-item">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
              ></path><circle cx="12" cy="10" r="3"></circle></svg
            >
            <span
              >Rua Marechal Floriano Peixoto, 284<br />Santo Antônio da Patrulha
              - RS</span
            >
          </div>
          <div class="contact-item">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path></svg
            >
            <span>(51) 3662-7032</span>
          </div>
        </div>

        <div class="footer-social">
          <h4 class="footer-heading">Siga-nos</h4>
          <div class="social-icons">
            <a
              href="https://instagram.com/jk_advocacia"
              target="_blank"
              aria-label="Instagram"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                ></rect><path
                  d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                ></line></svg
              >
            </a>
            <a href="#" aria-label="Facebook">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                ></path></svg
              >
            </a>
            <a href="#" aria-label="LinkedIn">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path><rect x="2" y="9" width="4" height="12"></rect><circle
                  cx="4"
                  cy="4"
                  r="2"></circle></svg
              >
            </a>
          </div>
          <div class="footer-seal">
            <Image src={selo} alt="Selo 100% Qualidade" class="seal-image" />
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>
          &copy; {new Date().getFullYear()} JK Advogados. Todos os direitos reservados.
        </p>
      </div>
    </div>
  </section>
</footer>

<style>
  /* Seus estilos do footer... */
  .site-footer {
    display: flex;
    flex-direction: column;
  }
  .quote-section {
    background-color: #ffffff;
    padding: 6rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .quote-icon {
    font-family: "Playfair Display", serif;
    font-size: 5rem;
    color: #519cae;
    line-height: 0.5;
    margin-bottom: 1rem;
  }
  .quote-text {
    font-family: "Playfair Display", serif;
    font-size: 2.25rem;
    color: #1e293b;
    margin-bottom: 2.5rem;
    max-width: 800px;
    line-height: 1.3;
  }
  .quote-logo {
    height: 3.5rem;
    width: auto;
    filter: grayscale(100%) opacity(0.7);
    transition: filter 0.3s;
    transform: translateX(-8px);
  }
  .quote-logo:hover {
    filter: grayscale(0%) opacity(1);
  }
  .main-footer {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 5rem 2rem 2rem;
    font-family: sans-serif;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }
  .footer-heading {
    color: #f8fafc;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    font-family: "Playfair Display", serif;
    letter-spacing: 0.05em;
  }
  .footer-logo {
    height: 3rem;
    width: auto;
    margin-bottom: 1.5rem;
  }
  .brand-text {
    color: #e2e8f0;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  .brand-cnpj {
    font-size: 0.85rem;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-nav a {
    color: #94a3b8;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.2s;
  }
  .footer-nav a:hover {
    color: #519cae;
    transform: translateX(5px);
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .contact-item svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #519cae;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .social-icons {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .social-icons a {
    color: #f8fafc;
    background-color: rgba(255, 255, 255, 0.05);
    padding: 0.5rem;
    border-radius: 0.25rem;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .social-icons a:hover {
    background-color: #519cae;
    color: white;
  }
  .social-icons svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .seal-image {
    width: 110px;
    height: auto;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    text-align: center;
    font-size: 0.85rem;
  }
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .quote-text {
      font-size: 1.5rem;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
