---
import { getCollection } from "astro:content";

const membrosRaw = await getCollection("equipe");

const equipeCompleta = membrosRaw
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map((membro) => {
    let fotoPath = membro.data.foto;
    if (!fotoPath) {
      fotoPath = "/src/assets/simbolojk.png";
    } else if (!fotoPath.startsWith("/")) {
      fotoPath = `/${fotoPath}`;
    }

    return {
      ...membro.data,
      foto: fotoPath,
    };
  });
---

<section class="equipe-moderna-section">
  <div class="container">
    <h2 class="section-heading">Nossos Profissionais</h2>
    <div class="equipe-moderna-list">
      {
        equipeCompleta.map((membro, index) => (
          <div class={`membro-row ${index % 2 !== 0 ? "reverso" : ""}`}>
            <div class="membro-col-foto">
              <div class="foto-frame">
                <img 
                  src={membro.foto} 
                  alt={membro.nome} 
                  class="membro-img" 
                  onerror="this.onerror=null; this.src='/src/assets/simbolojk.png';"
                />
              </div>
            </div>
            <div class="membro-col-texto">
              <h3 class="membro-nome">{membro.nome}</h3>
              <p class="membro-cargo">{membro.cargo}</p>
              <div class="membro-bio">
                {membro.textos.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .equipe-moderna-section {
    padding: 4rem 2rem 8rem;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-heading {
    font-family: "Playfair Display", serif;
    font-size: 2.8rem;
    text-align: center;
    margin-bottom: 5rem;
    color: #1e293b;
  }
  .equipe-moderna-list {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }
  .membro-row {
    display: flex;
    gap: 4rem;
  }
  .membro-row.reverso {
    flex-direction: row-reverse;
  }
  .membro-col-foto {
    flex: 0 0 400px;
    position: sticky;
    top: 120px;
  }
  .foto-frame {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }
  .membro-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05);
  }
  .membro-nome {
    font-family: "Playfair Display", serif;
    font-size: 2.5rem;
    color: #0f172a;
    margin-bottom: 0.5rem;
    line-height: 1.1;
  }
  .membro-cargo {
    color: #519cae;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 1rem;
    display: inline-block;
    letter-spacing: 0.05em;
  }
  .membro-bio p {
    line-height: 1.8;
    margin-bottom: 1.25rem;
    color: #475569;
    text-align: justify;
    font-family: sans-serif;
    font-size: 1.05rem;
  }

  @media (max-width: 1024px) {
    .membro-col-foto {
      flex: 0 0 300px;
    }
    .membro-row {
      gap: 3rem;
    }
  }

  @media (max-width: 800px) {
    .membro-row,
    .membro-row.reverso {
      flex-direction: column;
      gap: 2rem;
    }
    .membro-col-foto {
      position: static;
      width: 100%;
      max-width: 450px;
      margin: 0 auto;
    }
    .membro-nome {
      font-size: 2rem;
      text-align: center;
    }
    .membro-cargo {
      display: block;
      text-align: center;
    }
  }
</style>
