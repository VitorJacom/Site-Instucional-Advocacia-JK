---
import { Image } from "astro:assets";
import heroBgImage from "../assets/heroImage.jpeg";

import { getSiteContact } from "../lib/siteConfig";

const base = import.meta.env.BASE_URL;
const { linkInstagram, linkFacebook, linkLinkedin } = await getSiteContact();
---

<section class="hero">
  <div class="hero-bg" style={`background-image: url(${heroBgImage.src});`}>
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      Há mais de três décadas em defesa dos direitos sociais com experiência e
      comprometimento.
    </h1>
    <p class="hero-text">
      Oferecer inteligência Jurídica não é apenas parte da nossa trajetória, é
      um compromisso com a justiça que transforma vidas. Há mais de 30 anos,  
      construímos uma advocacia voltada à defesa de direitos sociais com
      experiência e dedicação.
    </p>
    <a href={`${base}/sobre`} class="hero-btn">Saiba Mais</a>
  </div>

  <div class="hero-social">
    {linkFacebook && (
      <a href={linkFacebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
        </svg>
      </a>
    )}
    {linkInstagram && (
      <a
        href={linkInstagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="social-icon"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
        </svg>
      </a>
    )}
    {linkLinkedin && linkLinkedin !== "#" && (
      <a href={linkLinkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect x="2" y="9" width="4" height="12" />
          <circle cx="4" cy="4" r="2" />
        </svg>
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding-top: 80px;
  }
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: -2;
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
    z-index: -1;
  }
  .hero-content {
    max-width: 800px;
    text-align: center;
    color: white;
    padding: 20px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-title {
    font-family: "Playfair Display", serif;
    font-size: 3rem;
    font-weight: normal;
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .hero-subtitle {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-weight: normal;
    margin-bottom: 15px;
  }
  .hero-text {
    font-family: sans-serif;
    font-size: 1.1rem;
    margin-bottom: 30px;
    max-width: 650px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }
  .hero-btn {
    background-color: #519cae;
    color: white;
    padding: 12px 30px;
    text-decoration: none;
    font-family: sans-serif;
    font-weight: bold;
    transition: background-color 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .hero-btn:hover {
    background-color: #3b7b8a;
  }
  .hero-social {
    position: absolute;
    right: 40px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 2;
  }
  .social-icon {
    color: white;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
    opacity: 0.8;
    width: 24px;
    height: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .social-icon svg {
    width: 100%;
    height: 100%;
  }
  .social-icon:hover {
    opacity: 1;
    color: #519cae;
    transform: scale(1.1);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 70vh;
      padding-top: 100px;
    }
    .hero-title {
      font-size: 1.75rem;
    }
    .hero-subtitle {
      font-size: 1.25rem;
    }
    .hero-text {
      font-size: 0.95rem;
    }
    .hero-content {
      padding-right: 40px;
      padding-left: 10px;
    } /* Recuo para não encostar nos ícones sociais */
    .hero-social {
      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
      flex-direction: column; /* Mantém vertical no celular */
      gap: 15px;
    }
    .social-icon {
      width: 20px;
      height: 20px;
    }
  }
</style>
