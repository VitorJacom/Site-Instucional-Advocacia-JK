---
const passos = [
  {
    numero: "01",
    titulo: "Triagem Inicial",
    descricao:
      "Recebimento do seu contato via WhatsApp ou formulário para entender a natureza básica do problema e direcionar ao especialista adequado.",
  },
  {
    numero: "02",
    titulo: "Análise de Documentos",
    descricao:
      "Solicitação e avaliação prévia de documentos essenciais (contratos, carteira de trabalho, laudos) para embasar a consulta.",
  },
  {
    numero: "03",
    titulo: "Consulta Jurídica",
    descricao:
      "Reunião aprofundada (presencial ou online) para diagnóstico completo da situação, esclarecimento de dúvidas e desenho da estratégia.",
  },
  {
    numero: "04",
    titulo: "Ação e Acompanhamento",
    descricao:
      "Ajuizamento de ações, defesas ou negociações, com reporte periódico sobre o andamento do seu caso nos tribunais ou extrajudicialmente.",
  },
];
---

<section class="passos-section">
  <div class="container">
    <h2 class="section-title">Como Funciona</h2>

    <div class="passos-grid">
      {
        passos.map((passo) => (
          <div class="passo-card">
            <span class="passo-numero">{passo.numero}</span>
            <h3>{passo.titulo}</h3>
            <p>{passo.descricao}</p>
          </div>
        ))
      }
    </div>

    <div class="modalidades-box">
      <h3>Modalidades de Atendimento</h3>
      <div class="modalidades-grid">
        <div class="modalidade">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
          <h4>Presencial</h4>
          <p>
            Reuniões em nossas sedes físicas em Santo Antônio da Patrulha, Capão
            da Canoa ou sindicatos parceiros.
          </p>
        </div>
        <div class="modalidade">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
              x1="8"
              y1="21"
              x2="16"
              y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
          >
          <h4>Online</h4>
          <p>
            Consultas virtuais via Google Meet, Zoom ou WhatsApp, garantindo
            suporte jurídico em qualquer lugar do Brasil.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .passos-section {
    padding: 6rem 2rem;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-family: "Playfair Display", serif;
    font-size: 2.5rem;
    color: #1e293b;
    text-align: center;
    margin-bottom: 4rem;
  }

  .passos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 5rem;
  }
  .passo-card {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    position: relative;
    border-top: 4px solid #519cae;
  }
  .passo-numero {
    font-family: "Playfair Display", serif;
    font-size: 3rem;
    color: #e2e8f0;
    font-weight: bold;
    position: absolute;
    top: 1rem;
    right: 1rem;
    line-height: 1;
  }
  .passo-card h3 {
    font-family: sans-serif;
    font-size: 1.2rem;
    color: #1e293b;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
    margin-top: 1rem;
  }
  .passo-card p {
    font-family: sans-serif;
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  .modalidades-box {
    background: #1e293b;
    color: white;
    padding: 4rem;
    border-radius: 12px;
    text-align: center;
  }
  .modalidades-box h3 {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    margin-bottom: 3rem;
  }
  .modalidades-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .modalidade {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .modalidade svg {
    width: 48px;
    height: 48px;
    color: #519cae;
    margin-bottom: 1rem;
  }
  .modalidade h4 {
    font-family: sans-serif;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .modalidade p {
    font-family: sans-serif;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 400px;
  }

  @media (max-width: 1024px) {
    .passos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .modalidades-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .modalidades-box {
      padding: 3rem 2rem;
    }
  }
  @media (max-width: 640px) {
    .passos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
