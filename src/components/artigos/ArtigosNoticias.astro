---
import { getCollection } from "astro:content";

interface Props {
  limitar?: boolean;
}
const { limitar = false } = Astro.props;

const postsNoticias = await getCollection("noticias");
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith("/") ? base.slice(0, -1) : base;

// Ordenar as notícias pela data (mais recente primeiro)
const postsOrdenados = postsNoticias.sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
const totalNoticias = postsOrdenados.length;
const postsFiltrados = limitar ? postsOrdenados.slice(0, 4) : postsOrdenados;

const noticias = postsFiltrados.map((noticia) => {
  // Formata a data para "15 Out 2023"
  const dataFormatada = new Intl.DateTimeFormat("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  })
    .format(noticia.data.data)
    .replace(".", ""); // Remove o ponto do mês se houver

  return {
    data: dataFormatada,
    titulo: noticia.data.titulo,
    resumo: noticia.data.resumo,
    link: noticia.data.link_externo || `${cleanBase}/noticias/${noticia.id}/`,
  };
});
---

<section class="noticias-section">
  <div class="container">
    <h2 class="section-title">Últimas Notícias</h2>
    <div class="noticias-list">
      {
        noticias.length > 0 ? (
          noticias.map((noticia) => (
            <div class="noticia-item">
              <h3 class="noticia-title">
                <span>{noticia.data}</span> - {noticia.titulo}
              </h3>
              <p class="noticia-resumo">{noticia.resumo}</p>
              <a href={noticia.link} class="noticia-link">
                Ver Notícia
              </a>
            </div>
          ))
        ) : (
          <p>Nenhuma notícia publicada.</p>
        )
      }
    </div>

    {limitar && totalNoticias > 6 && (
      <div class="ver-todos-container">
        <a href={`${cleanBase}/noticias/todas/`} class="btn-ver-todos">
          Ver Todas as Notícias
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .noticias-section {
    padding: 5rem 2rem;
    background-color: white;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
  }
  .section-title {
    font-family: "Playfair Display", serif;
    font-size: 2.5rem;
    color: #1e293b;
    text-align: center;
    margin-bottom: 3rem;
  }
  .noticias-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .noticia-item {
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 2rem;
  }
  .noticia-item:last-child {
    border-bottom: none;
  }
  .noticia-title {
    font-family: "Playfair Display", serif;
    font-size: 1.4rem;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }
  .noticia-title span {
    font-family: sans-serif;
    font-size: 1rem;
    color: #64748b;
    font-weight: normal;
  }
  .noticia-resumo {
    font-family: sans-serif;
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .noticia-link {
    font-family: sans-serif;
    font-size: 0.9rem;
    font-weight: bold;
    color: #519cae;
    text-decoration: underline;
  }
  
  .ver-todos-container {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }
  .btn-ver-todos {
    font-family: sans-serif;
    font-size: 0.9rem;
    font-weight: bold;
    color: #519cae;
    border: 2px solid #519cae;
    background-color: transparent;
    padding: 0.85rem 2.5rem;
    text-align: center;
    text-decoration: none;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }
  .btn-ver-todos:hover {
    background-color: #519cae;
    color: white;
    transform: translateY(-2px);
  }
</style>
