---
import { getCollection } from "astro:content";

interface Props {
  limitar?: boolean;
}
const { limitar = false } = Astro.props;

const posts = await getCollection("artigos");

// Ordenar os posts por data de publicação (mais recente primeiro)
const postsOrdenados = posts.sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const totalArtigos = postsOrdenados.length;
const postsFiltrados = limitar ? postsOrdenados.slice(0, 6) : postsOrdenados;

const artigos = postsFiltrados.map((post, index) => {
  // Geração automática do número (0 -> "01.", 1 -> "02.", etc)
  const numeroAuto = (index + 1).toString().padStart(2, "0") + ".";

  let capaFinal = post.data.capa || "/src/assets/simbolojk.png";
  if (post.data.capa && !capaFinal.startsWith("/")) {
    capaFinal = `/${capaFinal}`;
  }

  return {
    ...post.data,
    numero: numeroAuto, // Injetamos o número gerado aqui
    capa: capaFinal,
    url: post.data.slug_personalizado || post.id,
  };
});
---

<section class="artigos-lista-section">
  <div class="container">
    <div class="artigos-grid">
      {
        artigos.map((artigo) => (
          <article class="artigo-card">
            <div class="artigo-img-wrapper">
              <img 
                src={artigo.capa} 
                alt={artigo.titulo} 
                class="artigo-img" 
                onerror="this.onerror=null; this.src='/src/assets/simbolojk.png';"
              />
            </div>
            <div class="artigo-content">
              <h3 class="artigo-title">
                {/* O número agora vem do JS, não do Markdown */}
                <span>{artigo.numero}</span> {artigo.titulo}
              </h3>
              <p class="artigo-resumo">{artigo.resumo}</p>
              <p class="artigo-autor">Por {artigo.autor}</p>

              {artigo.url && (
                <a
                  href={`/artigos/${artigo.url}/`}
                  class="btn-saiba-mais"
                >
                  SAIBA MAIS
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
    
    {limitar && totalArtigos > 6 && (
      <div class="ver-todos-container">
        <a href="/artigos/todos/" class="btn-ver-todos">
          Ver Todos os Artigos
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .artigo-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
</style>

<style>
  .artigos-lista-section {
    padding: 5rem 2rem;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .artigos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .artigo-card {
    background: white;
    border-radius: 4px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .artigo-img-placeholder {
    width: 100%;
    height: 200px;
    background: #cbd5e1;
  }
  .artigo-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .artigo-title {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    color: #1e293b;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .artigo-title span {
    color: #519cae;
  }
  .artigo-resumo {
    font-family: sans-serif;
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }
  .artigo-autor {
    font-family: sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    color: #1e293b;
    margin-bottom: 1.5rem;
  }
  .btn-saiba-mais {
    font-size: 0.8rem;
    font-weight: bold;
    color: white;
    background-color: #519cae;
    padding: 0.75rem 1.5rem;
    text-align: center;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.3s;
  }
  .btn-saiba-mais:hover {
    background-color: #3b7b8a;
  }
  
  .ver-todos-container {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }
  .btn-ver-todos {
    font-family: sans-serif;
    font-size: 0.9rem;
    font-weight: bold;
    color: #519cae;
    border: 2px solid #519cae;
    background-color: transparent;
    padding: 0.85rem 2.5rem;
    text-align: center;
    text-decoration: none;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }
  .btn-ver-todos:hover {
    background-color: #519cae;
    color: white;
    transform: translateY(-2px);
  }
  
  @media (max-width: 900px) {
    .artigos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .artigos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
