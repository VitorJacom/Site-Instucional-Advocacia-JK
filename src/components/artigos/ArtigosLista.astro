---
import { getCollection } from "astro:content";

const posts = await getCollection("artigos");
const base = "/Site-Instucional-Advocacia-JK";

// Opcional: ordenar os posts por data ou nome de arquivo antes de numerar
const postsOrdenados = posts.sort((a, b) => a.id.localeCompare(b.id));

const artigos = postsOrdenados.map((post, index) => {
  // Geração automática do número (0 -> "01.", 1 -> "02.", etc)
  const numeroAuto = (index + 1).toString().padStart(2, "0") + ".";

  let capaFinal = post.data.capa || `${base}/src/assets/simbolojk.png`;
  if (post.data.capa && !capaFinal.startsWith(base)) {
    capaFinal = `${base}${capaFinal.startsWith("/") ? "" : "/"}${capaFinal}`;
  }

  return {
    ...post.data,
    numero: numeroAuto, // Injetamos o número gerado aqui
    capa: capaFinal,
    url: post.data.slug_personalizado,
  };
});
---

<section class="artigos-lista-section">
  <div class="container">
    <div class="artigos-grid">
      {
        artigos.map((artigo) => (
          <article class="artigo-card">
            <div class="artigo-img-wrapper">
              <img src={artigo.capa} alt={artigo.titulo} class="artigo-img" />
            </div>
            <div class="artigo-content">
              <h3 class="artigo-title">
                {/* O número agora vem do JS, não do Markdown */}
                <span>{artigo.numero}</span> {artigo.titulo}
              </h3>
              <p class="artigo-resumo">{artigo.resumo}</p>
              <p class="artigo-autor">Por {artigo.autor}</p>

              {artigo.url && (
                <a
                  href={`${base}/artigos/${artigo.url}/`}
                  class="btn-saiba-mais"
                >
                  SAIBA MAIS
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .artigo-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
</style>

<style>
  .artigos-lista-section {
    padding: 5rem 2rem;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .artigos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .artigo-card {
    background: white;
    border-radius: 4px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .artigo-img-placeholder {
    width: 100%;
    height: 200px;
    background: #cbd5e1;
  }
  .artigo-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .artigo-title {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    color: #1e293b;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .artigo-title span {
    color: #519cae;
  }
  .artigo-resumo {
    font-family: sans-serif;
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }
  .artigo-autor {
    font-family: sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    color: #1e293b;
    margin-bottom: 1.5rem;
  }
  .btn-saiba-mais {
    font-size: 0.8rem;
    font-weight: bold;
    color: white;
    background-color: #519cae;
    padding: 0.75rem 1.5rem;
    text-align: center;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.3s;
  }
  .btn-saiba-mais:hover {
    background-color: #3b7b8a;
  }
  @media (max-width: 900px) {
    .artigos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .artigos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
