---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Página não encontrada - JK Advogados">
  <Header />

  <main class="error-page">
    <div class="container text-center">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Página não encontrada</h2>
      <p class="error-desc">
        Desculpe, a página que você está procurando não existe, foi removida ou
        está temporariamente indisponível.
      </p>
      <a href="/" class="btn-home">VOLTAR PARA O INÍCIO</a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .error-page {
    background-color: #f8fafc;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12rem 2rem 8rem;
  }

  .text-center {
    text-align: center;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .error-code {
    font-family: "Playfair Display", serif;
    font-size: 10rem;
    color: #e2e8f0;
    line-height: 1;
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.05);
  }

  .error-title {
    font-family: "Playfair Display", serif;
    font-size: 2.5rem;
    color: #1e293b;
    margin-bottom: 1.5rem;
  }

  .error-desc {
    font-family: sans-serif;
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 3rem;
  }

  .btn-home {
    display: inline-block;
    background-color: #1e293b;
    color: white;
    padding: 1rem 2.5rem;
    text-decoration: none;
    font-weight: bold;
    font-family: sans-serif;
    font-size: 0.95rem;
    border-radius: 6px;
    transition: background-color 0.3s;
  }

  .btn-home:hover {
    background-color: #519cae;
  }

  @media (max-width: 640px) {
    .error-code {
      font-size: 6rem;
    }
    .error-title {
      font-size: 2rem;
    }
    .error-page {
      padding-top: 10rem;
    }
  }
</style>
